---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import GraphPaper from "../components/GraphPaper.astro";

interface Props {
  title?: string;
  description?: string;
  /** Opacity of the graph-paper underlay. 1 = home grid, 0.5 = route pages, 0 = essays. */
  gridOpacity?: number;
}

const {
  title = "olga nikulina",
  description = "a small notebook",
  gridOpacity = 1,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <GraphPaper opacity={gridOpacity} />
    <slot />
  </body>
</html>
