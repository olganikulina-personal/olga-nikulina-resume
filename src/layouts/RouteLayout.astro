---
/*
 * RouteLayout — the shared system-document shell for non-essay routes.
 *
 * Essays use EssayLayout because their reading surface is intentionally
 * quieter. This shell keeps navigation and page chrome consistent while
 * leaving each route's content responsible for its own typography.
 */
import BaseLayout from "./BaseLayout.astro";
import RetroPanel from "../components/RetroPanel.astro";

interface Props {
  /** Route title rendered as the page H1. */
  title: string;
  /** Page <title> override; falls back to `${title} — olga nikulina`. */
  pageTitle?: string;
  /** <meta name="description"> for SEO. */
  description?: string;
  /** Legacy underlay control; route pages default to system chrome. */
  gridOpacity?: number;
}

const {
  title,
  pageTitle,
  description,
  gridOpacity = 0,
} = Astro.props;

const resolvedPageTitle = pageTitle ?? `${title} — olga nikulina`;
---

<BaseLayout title={resolvedPageTitle} description={description} gridOpacity={gridOpacity}>
  <div class="page">
    <header class="route-toolbar">
      <a href="/" class="back-link font-mono" aria-label="Back to home">← Explorer</a>
      <span class="path font-mono">Home / {title}</span>
    </header>

    <main class="route-main">
      <RetroPanel title="Document" class="route-panel">
        <header class="route-header">
          <p class="eyebrow font-mono">Document / {title}</p>
          <h1 class="title font-sans">{title}</h1>
        </header>

        <div class="route-content">
          <slot />
        </div>
      </RetroPanel>
    </main>

    <div class="status-bar font-mono" aria-label="System status">
      <span>Ready</span>
      <span>Opened / {title}</span>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 100vh;
    max-width: 1280px;
    margin: 0 auto;
    padding: 1rem;
    background: var(--system-bg);
    color: var(--system-text);
  }

  .route-toolbar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--system-border-dark);
    background: var(--system-panel);
    box-shadow:
      inset 1px 1px 0 var(--system-border-light),
      inset -1px -1px 0 var(--system-border-deep);
  }

  .back-link,
  .path {
    font-size: var(--text-xs);
    color: var(--system-muted);
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .back-link {
    color: var(--system-title);
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--system-accent);
  }

  .back-link:focus-visible {
    outline: 2px solid var(--system-accent);
    outline-offset: 3px;
  }

  .path {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .route-main {
    flex: 1;
  }

  .route-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .eyebrow {
    margin: 0;
    color: var(--system-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
  }

  .title {
    margin: 0;
    color: var(--system-text);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 500;
    line-height: 1.1;
  }

  .route-content {
    margin-top: 1.5rem;
  }

  .status-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.375rem 0.5rem;
    border: 1px solid var(--system-border-dark);
    background: var(--system-panel);
    color: var(--system-muted);
    font-size: var(--text-xs);
  }

  @media (max-width: 480px) {
    .page {
      padding: 0.75rem;
    }

    .route-toolbar,
    .status-bar {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }

    .route-content {
      margin-top: 1rem;
    }
  }
</style>
