---
/*
 * EssayLayout — a quiet reading document inside the site's system chrome.
 *
 * The framing follows RouteLayout, while the essay body stays Source Serif 4
 * for sustained reading.
 */
import BaseLayout from "./BaseLayout.astro";
import RetroPanel from "../components/RetroPanel.astro";
import { cards, type Card } from "../lib/cards";

interface Props {
  card: Card;
  title: string;
  subtitle?: string;
  publishedAt: Date;
  updatedAt?: Date;
}

const { card, title, subtitle, publishedAt, updatedAt } = Astro.props;

const essays = cards.filter((c) => c.isEssay);
const idx = essays.findIndex((c) => c.slug === card.slug);
const prev = idx > 0 ? essays[idx - 1] : null;
const next = idx >= 0 && idx < essays.length - 1 ? essays[idx + 1] : null;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout
  title={`${title} — olga nikulina`}
  description={subtitle ?? title}
  gridOpacity={0}
>
  <div class="page">
    <header class="essay-toolbar">
      <a href="/" class="back-link font-mono" aria-label="Back to home">← Explorer</a>
      <span class="path font-mono">Home / Thoughts / {title}</span>
    </header>

    <main class="essay-main">
      <RetroPanel title="Thought" class="essay-panel">
        <header class="essay-header">
          <p class="eyebrow font-mono">Document / thought</p>
          <h1 class="title">{title}</h1>
          {subtitle && <p class="subtitle">{subtitle}</p>}
          <p class="meta font-mono">
            <time datetime={publishedAt.toISOString()}>{fmt(publishedAt)}</time>
            {updatedAt && (
              <>
                <span aria-hidden="true"> · </span>
                <span>
                  updated <time datetime={updatedAt.toISOString()}>{fmt(updatedAt)}</time>
                </span>
              </>
            )}
          </p>
        </header>

        <article class="prose">
          <slot />
        </article>

        {(prev || next) && (
          <nav class="essay-nav" aria-label="Other essays">
            {prev ? (
              <a
                href={prev.href}
                class="nav-link prev font-sans"
                aria-label={`Previous essay: ${prev.title}`}
              >
                <span class="nav-dir font-mono">← Previous</span>
                <span class="nav-title">{prev.title}</span>
              </a>
            ) : (
              <span class="nav-spacer" aria-hidden="true"></span>
            )}
            {next ? (
              <a
                href={next.href}
                class="nav-link next font-sans"
                aria-label={`Next essay: ${next.title}`}
              >
                <span class="nav-dir font-mono">Next →</span>
                <span class="nav-title">{next.title}</span>
              </a>
            ) : (
              <span class="nav-spacer" aria-hidden="true"></span>
            )}
          </nav>
        )}
      </RetroPanel>
    </main>

    <div class="status-bar font-mono" aria-label="System status">
      <span>Ready</span>
      <span>Reading / {title}</span>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 100vh;
    max-width: 1280px;
    margin: 0 auto;
    padding: 1rem;
    background: var(--system-bg);
    color: var(--system-text);
  }

  .essay-toolbar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--system-border-dark);
    background: var(--system-panel);
    box-shadow:
      inset 1px 1px 0 var(--system-border-light),
      inset -1px -1px 0 var(--system-border-deep);
  }

  .back-link,
  .path {
    font-size: var(--text-xs);
    color: var(--system-muted);
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .back-link {
    color: var(--system-title);
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--system-accent);
  }

  .back-link:focus-visible {
    outline: 2px solid var(--system-accent);
    outline-offset: 3px;
  }

  .path {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .essay-main {
    flex: 1;
  }

  .essay-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .eyebrow {
    margin: 0;
    color: var(--system-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
  }

  .title {
    margin: 0;
    color: var(--system-text);
    font-family: var(--font-serif);
    font-size: clamp(1.875rem, 4vw, 2.625rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .subtitle {
    margin: 0;
    color: var(--system-muted);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-style: italic;
    line-height: 1.4;
  }

  .meta {
    margin: 0;
    color: var(--system-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  .prose {
    margin-top: 2rem;
    color: var(--system-text);
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .prose :global(p) {
    margin: 0 0 1.1em;
  }

  .prose :global(h2) {
    margin: calc(var(--grid-step) * 1.5) 0 0.5rem;
    color: var(--system-text);
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.2;
  }

  .prose :global(h3) {
    margin: calc(var(--grid-step) * 1) 0 0.25rem;
    color: var(--system-text);
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .prose :global(blockquote) {
    margin: 1.25rem 0;
    padding-left: 1rem;
    border-left: 1px solid var(--system-border-dark);
    color: var(--system-muted);
    font-style: italic;
  }

  .prose :global(a) {
    color: var(--system-title);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) {
    color: var(--system-accent);
  }

  .prose :global(code) {
    padding: 0.1em 0.35em;
    background: var(--paper-soft);
    font-family: var(--font-mono);
    font-size: 0.92em;
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    background: var(--paper-soft);
    font-family: var(--font-mono);
    font-size: 0.85em;
    line-height: 1.5;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0.5rem 0 1rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.35rem;
  }

  .prose :global(hr) {
    margin: calc(var(--grid-step) * 1.5) 0;
    border: none;
    border-top: 1px solid var(--system-border-dark);
  }

  .essay-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--system-border-dark);
  }

  .nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--system-text);
    text-decoration: none;
  }

  .nav-link.next {
    align-items: flex-end;
    text-align: right;
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--system-accent);
    outline-offset: 3px;
  }

  .nav-dir {
    color: var(--system-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  .nav-title {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .nav-link:hover .nav-title {
    color: var(--system-accent);
  }

  .nav-spacer {
    display: block;
  }

  .status-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.375rem 0.5rem;
    border: 1px solid var(--system-border-dark);
    background: var(--system-panel);
    color: var(--system-muted);
    font-size: var(--text-xs);
  }

  @media (max-width: 480px) {
    .page {
      padding: 0.75rem;
    }

    .essay-toolbar,
    .status-bar {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }

    .prose {
      margin-top: 1.5rem;
    }

    .essay-nav {
      grid-template-columns: 1fr;
    }

    .nav-link.next {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
