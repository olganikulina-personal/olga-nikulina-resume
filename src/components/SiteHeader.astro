---
import { getWeatherSnapshot } from "../lib/weather";

/*
 * SiteHeader — the home surface's identity strip.
 * Route pages use RouteLayout's back link instead.
 */

const weather = await getWeatherSnapshot();
---

<header class="site-header">
  <span class="wordmark font-sans">Los Angeles, CA</span>
  <span class="weather font-mono" aria-label={`Current weather: ${weather.line}`}>
    <svg
      class={`weather-icon weather-${weather.kind}`}
      viewBox="0 0 16 16"
      width="16"
      height="16"
      aria-hidden="true"
      focusable="false"
      shape-rendering="crispEdges"
    >
      {weather.kind === "clear" && (
        <>
          <circle cx="8" cy="8" r="3" fill="var(--system-accent)" />
          <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l2 2M11 11l2 2M13 3l-2 2M5 11l-2 2" stroke="var(--system-accent)" />
        </>
      )}
      {weather.kind === "cloudy" && (
        <>
          <circle cx="6" cy="6" r="3" fill="var(--system-accent)" />
          <path d="M4 12h9a2 2 0 0 0 0-4 4 4 0 0 0-7-1 3 3 0 0 0-2 5z" fill="var(--system-selected)" stroke="var(--system-border-dark)" />
        </>
      )}
      {weather.kind === "foggy" && (
        <>
          <path d="M2 5h12M1 8h14M2 11h12" stroke="var(--system-muted)" stroke-width="1.5" />
        </>
      )}
      {weather.kind === "rainy" && (
        <>
          <path d="M3 9h10a2 2 0 0 0 0-4 4 4 0 0 0-7-1 3 3 0 0 0-3 5z" fill="var(--system-selected)" stroke="var(--system-border-dark)" />
          <path d="M5 12l-1 2M9 12l-1 2M13 12l-1 2" stroke="var(--system-accent)" />
        </>
      )}
      {weather.kind === "snowy" && (
        <>
          <path d="M3 9h10a2 2 0 0 0 0-4 4 4 0 0 0-7-1 3 3 0 0 0-3 5z" fill="var(--system-selected)" stroke="var(--system-border-dark)" />
          <path d="M5 12v3M3.5 13.5h3M9 12v3M7.5 13.5h3M13 12v3M11.5 13.5h3" stroke="var(--system-accent)" />
        </>
      )}
      {weather.kind === "stormy" && (
        <>
          <path d="M3 9h10a2 2 0 0 0 0-4 4 4 0 0 0-7-1 3 3 0 0 0-3 5z" fill="var(--system-selected)" stroke="var(--system-border-dark)" />
          <path d="m9 10-2 3h2l-1 3 4-5h-2l1-2z" fill="var(--system-accent)" />
        </>
      )}
    </svg>
    {weather.line}
  </span>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--system-border-dark);
    background: var(--system-panel);
    color: var(--ink);
    box-shadow:
      inset 1px 1px 0 var(--system-border-light),
      inset -1px -1px 0 var(--system-border-deep);
  }

  .wordmark {
    min-width: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--system-text);
    letter-spacing: 0.01em;
  }

  .weather {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    color: var(--system-muted);
    font-size: var(--text-xs);
    text-align: right;
  }

  .weather-icon {
    flex: 0 0 auto;
    overflow: visible;
  }

  @media (max-width: 480px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .weather {
      text-align: left;
    }
  }
</style>
