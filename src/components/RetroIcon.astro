---
export type RetroIconName = "home" | "bio" | "resume" | "thoughts" | "contact" | "essay";

interface Props {
  name: RetroIconName;
}

const { name } = Astro.props;
---

<svg
  class={`retro-icon icon-${name}`}
  viewBox="0 0 16 16"
  width="16"
  height="16"
  aria-hidden="true"
  focusable="false"
  shape-rendering="crispEdges"
>
  {name === "home" && (
    <>
      <rect x="1" y="2" width="14" height="10" fill="var(--system-title)" />
      <rect x="3" y="4" width="10" height="6" fill="var(--system-selected)" />
      <rect x="6" y="13" width="4" height="1" fill="var(--system-text)" />
      <rect x="4" y="14" width="8" height="1" fill="var(--system-border-dark)" />
    </>
  )}
  {name === "bio" && (
    <>
      <rect x="2" y="1" width="12" height="14" fill="var(--system-border-dark)" />
      <rect x="3" y="2" width="10" height="12" fill="var(--system-panel)" />
      <rect x="6" y="4" width="4" height="3" fill="var(--system-accent)" />
      <rect x="5" y="8" width="6" height="1" fill="var(--system-text)" />
      <rect x="4" y="10" width="8" height="1" fill="var(--system-muted)" />
      <rect x="4" y="12" width="8" height="1" fill="var(--system-muted)" />
    </>
  )}
  {name === "resume" && (
    <>
      <path d="M3 1h7l3 3v11H3z" fill="var(--system-panel)" />
      <path d="M10 1v4h3" fill="var(--system-selected)" />
      <path d="M3 1h7l3 3v11H3zM10 1v4h3" fill="none" stroke="var(--system-border-dark)" />
      <rect x="5" y="7" width="6" height="1" fill="var(--system-title)" />
      <rect x="5" y="9" width="5" height="1" fill="var(--system-muted)" />
      <rect x="5" y="11" width="6" height="1" fill="var(--system-muted)" />
    </>
  )}
  {name === "thoughts" && (
    <>
      <path d="M1 3h6v11H2a1 1 0 0 1-1-1z" fill="var(--system-selected)" />
      <path d="M15 3H9v11h5a1 1 0 0 0 1-1z" fill="var(--system-panel)" />
      <path d="M8 4v10M1 3h6v11H2a1 1 0 0 1-1-1zM15 3H9v11h5a1 1 0 0 0 1-1z" fill="none" stroke="var(--system-border-dark)" />
      <rect x="3" y="6" width="3" height="1" fill="var(--system-title)" />
      <rect x="10" y="6" width="3" height="1" fill="var(--system-title)" />
    </>
  )}
  {name === "contact" && (
    <>
      <rect x="1" y="3" width="14" height="10" fill="var(--system-panel)" stroke="var(--system-border-dark)" />
      <path d="m2 4 6 5 6-5" fill="none" stroke="var(--system-accent)" stroke-width="2" />
      <path d="m2 12 4-4M14 12l-4-4" fill="none" stroke="var(--system-muted)" />
    </>
  )}
  {name === "essay" && (
    <>
      <path d="M3 1h7l3 3v11H3z" fill="var(--system-panel)" />
      <path d="M10 1v4h3" fill="var(--system-selected)" />
      <path d="M3 1h7l3 3v11H3zM10 1v4h3" fill="none" stroke="var(--system-border-dark)" />
      <rect x="5" y="8" width="6" height="1" fill="var(--system-title)" />
      <rect x="5" y="10" width="5" height="1" fill="var(--system-muted)" />
    </>
  )}
</svg>
