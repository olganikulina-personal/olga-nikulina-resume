---
import RetroPanel from "./RetroPanel.astro";
import RetroIcon, { type RetroIconName } from "./RetroIcon.astro";

export interface ExplorerItem {
  label: string;
  href: string;
  description: string;
  icon: RetroIconName;
  children?: ExplorerChild[];
}

export interface ExplorerChild {
  label: string;
  href: string;
}

interface Props {
  items: ExplorerItem[];
}

const { items } = Astro.props;
---

<div class="explorer-wrapper">
  <RetroPanel title="Explorer" meta="5 items" class="explorer-panel">
    <nav aria-label="Primary">
      <ul class="explorer-list">
        <li>
          <a href="/" class="explorer-link home-link" aria-current="page">
            <RetroIcon name="home" />
            <span>
              <span class="link-label">Home</span>
              <span class="link-description">System properties</span>
            </span>
          </a>
        </li>
        <li class="group-label font-mono">Places</li>
        {items.map((item) => (
          <li class:list={{ "has-submenu": Boolean(item.children) }}>
            {item.children ? (
              <details class="explorer-group">
                <summary class="explorer-link">
                  <RetroIcon name={item.icon} />
                  <span>
                    <span class="link-label">{item.label}</span>
                    <span class="link-description">{item.description}</span>
                  </span>
                  <span class="submenu-arrow" aria-hidden="true">▶</span>
                </summary>
                <ul class="sub-list">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class="explorer-link sub-link">
                        <RetroIcon name="essay" />
                        <span>
                          <span class="link-label">{child.label}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a href={item.href} class="explorer-link">
                <RetroIcon name={item.icon} />
                <span>
                  <span class="link-label">{item.label}</span>
                  <span class="link-description">{item.description}</span>
                </span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </RetroPanel>
</div>

<script>
  const closeThoughtsOnOutsideClick = (event: MouseEvent) => {
    const group = document.querySelector<HTMLDetailsElement>(".explorer-group[open]");
    const target = event.target;

    if (!group || !(target instanceof Node) || group.contains(target)) return;

    group.open = false;
  };

  document.addEventListener("click", closeThoughtsOnOutsideClick);
</script>

<style>
  .explorer-wrapper {
    position: relative;
    z-index: 3;
  }

  .explorer-panel {
    height: fit-content;
  }

  .explorer-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .group-label {
    padding: 0.625rem 0.5rem 0.25rem;
    color: var(--system-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
  }

  .explorer-link {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: start;
    padding: 0.5rem;
    color: var(--system-text);
    text-decoration: none;
  }

  .explorer-group summary {
    cursor: pointer;
    list-style: none;
  }

  .explorer-group {
    position: relative;
  }

  .explorer-group summary::-webkit-details-marker {
    display: none;
  }

  .explorer-group summary {
    grid-template-columns: 1rem minmax(0, 1fr) auto;
  }

  .submenu-arrow {
    align-self: center;
    color: var(--system-muted);
    font-size: 0.625rem;
  }

  .explorer-link:hover,
  .explorer-link:focus-visible,
  .explorer-link[aria-current="page"] {
    background: var(--system-selected);
  }

  .explorer-link:focus-visible {
    outline: 2px solid var(--system-accent);
    outline-offset: 2px;
  }

  .sub-list {
    position: absolute;
    z-index: 2;
    top: 0;
    left: calc(100% + 0.5rem);
    display: flex;
    width: 16rem;
    flex-direction: column;
    gap: 0.125rem;
    list-style: none;
    margin: 0;
    padding: 0.25rem;
    background: var(--system-panel);
    border: 1px solid var(--system-border-dark);
    box-shadow:
      inset 1px 1px 0 var(--system-border-light),
      inset -1px -1px 0 var(--system-border-deep);
  }

  .sub-link {
    padding-block: 0.375rem;
  }

  .retro-icon {
    display: block;
    width: 1rem;
    height: 1rem;
    margin-top: 0.125rem;
  }

  .link-label,
  .link-description {
    display: block;
  }

  .link-label {
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.35;
  }

  .link-description {
    color: var(--system-muted);
    font-size: var(--text-xs);
    line-height: 1.35;
  }

  @media (max-width: 767px) {
    .has-submenu {
      grid-column: 1 / -1;
    }

    .sub-list {
      position: static;
      width: auto;
      margin: 0.25rem 0 0.25rem 1rem;
      padding: 0 0 0 0.5rem;
      border: 0;
      border-left: 1px solid var(--system-border-dark);
      box-shadow: none;
    }
  }
</style>
