---
interface Props {
  title: string;
  meta?: string;
  class?: string;
}

const { title, meta, class: className = "" } = Astro.props;
---

<section class={`retro-panel ${className}`.trim()}>
  <header class="title-bar">
    <h2 class="title">{title}</h2>
    {meta && <span class="meta font-mono">{meta}</span>}
  </header>
  <div class="panel-body">
    <slot />
  </div>
</section>

<style>
  .retro-panel {
    background: var(--system-panel);
    border: 1px solid var(--system-border-dark);
    box-shadow:
      inset 1px 1px 0 var(--system-border-light),
      inset -1px -1px 0 var(--system-border-deep);
  }

  .title-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2rem;
    padding: 0.25rem 0.5rem;
    background: var(--system-title);
    color: var(--system-title-text);
  }

  .title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.25;
  }

  .meta {
    color: color-mix(in srgb, var(--system-title-text) 75%, transparent);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .panel-body {
    padding: 1rem;
  }

  @media (max-width: 480px) {
    .panel-body {
      padding: 0.75rem;
    }
  }
</style>
