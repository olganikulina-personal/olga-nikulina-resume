---
import RouteLayout from "../layouts/RouteLayout.astro";
import { cards } from "../lib/cards";
import { getEntry } from "astro:content";

const card = cards.find((c) => c.slug === "resume")!;
const entry = await getEntry("resume", "resume");
if (!entry) {
  throw new Error("Missing content/resume.md — expected at repo root, symlinked into src/content/resume/resume.md");
}
const { Content } = await entry.render();
---

<RouteLayout
  slug={card.slug}
  callNumber={card.callNumber}
  title={card.title}
  description="ten years of building, leading, and shipping software."
>
  <div class="resume-actions">
    <a href="/Olga_Nikulina_Resume.pdf" class="pdf-link font-mono" download>
      download pdf →
    </a>
  </div>

  <article class="prose">
    <Content />
  </article>
</RouteLayout>

<style>
  .resume-actions {
    margin-bottom: calc(var(--grid-step) * 1);
  }

  .pdf-link {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    letter-spacing: 0.04em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .pdf-link:hover { color: var(--marker); }

  /*
   * .prose: typographic envelope for the rendered markdown. The MD pipeline
   * outputs unstyled tags; everything below is the type system speaking.
   * Long-form single-column scroll, 68ch measure for readability.
   *
   * The resume's H1 ('Olga Nikulina') is redundant with the RouteLayout's
   * title block, so it's hidden — the page already announces itself.
   */
  .prose {
    max-width: 68ch;
    font-size: var(--text-base);
    color: var(--ink);
    line-height: 1.65;
  }
  .prose :global(h1) {
    /* Visually hidden — RouteLayout already shows the page title.
       Kept in the document so screen-reader landmarks stay sensible. */
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  /* The single line below the H1 (city) — first paragraph after the
     hidden title. We style all p the same; nothing special needed. */
  .prose :global(h2) {
    font-size: var(--text-xl);
    font-weight: 500;
    margin: calc(var(--grid-step) * 2) 0 calc(var(--grid-step) * 0.5);
    line-height: 1.2;
    /* A faint rule under section headings — matches the graph-paper feel
       without screaming. Uses the design-token rule color, no marker. */
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.25rem;
  }
  .prose :global(h3) {
    font-size: var(--text-lg);
    font-weight: 500;
    margin: calc(var(--grid-step) * 1) 0 0.125rem;
    line-height: 1.25;
  }
  .prose :global(h4) {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--ink-soft);
    margin: calc(var(--grid-step) * 0.75) 0 0.25rem;
  }
  .prose :global(p) {
    margin: 0 0 0.5rem;
  }
  /* The job titles + dates render as <strong> in the MD. Restrain them. */
  .prose :global(strong) {
    font-weight: 500;
    color: var(--ink);
  }
  .prose :global(ul) {
    margin: 0.25rem 0 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .prose :global(li) {
    margin-bottom: 0.25rem;
  }
  .prose :global(li::marker) {
    color: var(--ink-faint);
  }
  .prose :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) { color: var(--marker); }

  /*
   * Print: when someone hits Cmd+P, give them a clean version.
   * Hide chrome, drop the graph paper, single column, full width.
   */
  @media print {
    :global(.graph-paper) { display: none !important; }
    :global(.back-link) { display: none !important; }
    .resume-actions { display: none; }
    .prose { max-width: none; font-size: 10pt; line-height: 1.4; }
    .prose :global(h2) { page-break-after: avoid; }
    .prose :global(h3) { page-break-after: avoid; }
  }
</style>
