---
import RouteLayout from "../layouts/RouteLayout.astro";
import { cards } from "../lib/cards";

const card = cards.find((c) => c.slug === "resume")!;
---

<RouteLayout
  slug={card.slug}
  callNumber={card.callNumber}
  title={card.title}
  description="ten years of building, leading, and shipping software."
>
  <p class="stub">resume content lands in U6.</p>
</RouteLayout>

<style>
  .stub { color: var(--ink-soft); font-size: var(--text-base); }
</style>
