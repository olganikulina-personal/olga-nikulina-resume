---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExplorerNav, { type ExplorerItem } from "../components/ExplorerNav.astro";
import RetroPanel from "../components/RetroPanel.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { cards } from "../lib/cards";

const navigation: ExplorerItem[] = [
  { label: "Bio", href: "/bio", description: "Inside cover", icon: "bio" },
  { label: "Resume", href: "/resume", description: "Working record", icon: "resume" },
  {
    label: "Thoughts",
    href: "/thoughts/faster-horse",
    description: "Essays and notes",
    icon: "thoughts",
    children: cards
      .filter((card) => card.isEssay)
      .map((card) => ({
        label: card.title,
        href: card.href,
      })),
  },
  { label: "Contact", href: "/contact", description: "Send a message", icon: "contact" },
];
---

<BaseLayout
  title="Olga Nikulina — senior full-stack engineer and team lead"
  description="Olga Nikulina is a senior full-stack engineer and team lead in Los Angeles who builds complex B2B products and stays close to the code."
  gridOpacity={0}
>
  <div class="page">
    <SiteHeader />

    <div class="desktop-layout">
      <ExplorerNav items={navigation} />

      <main class="home-main">
        <RetroPanel title="System properties" meta="olga-nikulina.exe" class="identity-panel">
          <div class="identity">
            <p class="eyebrow font-mono">User profile / Engineering</p>
            <h1>Olga Nikulina</h1>
            <p class="summary">
              Team lead and senior full-stack engineer with 10+ years building
              SaaS and eCommerce products. I lead nine engineers across two
              remote teams, stay hands-on in code and design, and turn
              ambiguous product ideas into reliable releases—from collaborative
              retail planning to AI-assisted engineering tools.
            </p>
            <p class="summary">
              I approach my work with honesty, openness, and a sense of humor.
              Remote work has taught me to be especially intentional about
              building trust and creating an environment where people feel
              comfortable speaking up, asking questions, and being themselves.
            </p>

            <dl class="details">
              <div>
                <dt class="font-mono">Focus</dt>
                <dd>Product engineering, player-coach leadership, technical design, and end-to-end delivery</dd>
              </div>
              <div>
                <dt class="font-mono">Stack</dt>
                <dd>TypeScript, JavaScript, React, Node.js, Go, Python, Java, SQL, PostgreSQL, Google Cloud, Docker, AI/LLM integration, GitHub Copilot</dd>
              </div>
            </dl>

            <a class="primary-link" href="/resume">
              Open working record
            </a>
          </div>
        </RetroPanel>
      </main>
    </div>

    <div class="status-bar font-mono" aria-label="System status">
      <span>Ready</span>
      <span class="online-status">
        <span class="online-indicator" aria-hidden="true"></span>
        Currently online
      </span>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 100vh;
    max-width: 1280px;
    margin: 0 auto;
    padding: 1rem;
    background: var(--system-bg);
    color: var(--system-text);
  }

  .desktop-layout {
    display: grid;
    grid-template-columns: minmax(13rem, 17rem) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    flex: 1;
  }

  .home-main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .identity {
    width: 100%;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--system-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
  }

  h1 {
    margin: 0;
    color: var(--system-text);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .summary {
    margin: 1rem 0 0;
    color: var(--system-text);
    font-size: 1.0625rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--system-border-dark);
  }

  .details div {
    min-width: 0;
  }

  dt {
    margin-bottom: 0.25rem;
    color: var(--system-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  dd {
    margin: 0;
    color: var(--system-text);
    font-size: var(--text-sm);
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .primary-link {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 1.5rem;
    padding: 0.625rem 0.75rem;
    background: var(--system-title);
    color: var(--system-title-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-decoration: none;
    box-shadow:
      inset 1px 1px 0 color-mix(in srgb, var(--system-title-text) 50%, transparent),
      inset -1px -1px 0 var(--system-border-deep);
  }

  .primary-link:hover {
    background: var(--system-accent);
  }

  .primary-link:focus-visible {
    outline: 2px solid var(--system-accent);
    outline-offset: 3px;
  }

  .online-status {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .online-indicator {
    display: block;
    width: 0.5rem;
    height: 0.5rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--system-online);
    border: 1px solid var(--system-border-deep);
  }

  .status-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.375rem 0.5rem;
    border: 1px solid var(--system-border-dark);
    background: var(--system-panel);
    color: var(--system-muted);
    font-size: var(--text-xs);
  }

  @media (max-width: 767px) {
    .page {
      padding: 0.75rem;
    }

    .desktop-layout {
      display: flex;
      flex-direction: column;
    }

    .explorer-panel {
      width: 100%;
    }

    .explorer-panel :global(.panel-body) {
      padding: 0.5rem;
    }

    .explorer-panel :global(.explorer-list) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.25rem;
    }

    .explorer-panel :global(.group-label) {
      grid-column: 1 / -1;
    }

    .identity-panel :global(.panel-body) {
      padding: 1rem;
    }

    .details {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .status-bar {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
