---
import RouteLayout from "../layouts/RouteLayout.astro";
import { cards } from "../lib/cards";

const card = cards.find((c) => c.slug === "bio")!;
---

<RouteLayout
  slug={card.slug}
  callNumber={card.callNumber}
  title={card.title}
  description="who I am, in brief."
>
  <p class="stub">
    bio content lands in U5.
  </p>
</RouteLayout>

<style>
  .stub {
    color: var(--ink-soft);
    font-size: var(--text-base);
  }
</style>
