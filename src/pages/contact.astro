---
import RouteLayout from "../layouts/RouteLayout.astro";
import ContactForm from "../components/ContactForm";
import { cards } from "../lib/cards";

const card = cards.find((c) => c.slug === "contact")!;
---

<RouteLayout
  title={card.title}
  description="Say hello."
>
  <p class="lede">
    Short notes, long emails, random questions — all welcome.
  </p>

  <ContactForm client:load />
</RouteLayout>

<style>
  .lede {
    color: var(--ink-soft);
    font-size: var(--text-base);
    line-height: 1.6;
    margin: 0 0 calc(var(--grid-step) * 1) 0;
  }
</style>
